datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions String   @default("[]") // JSON array of permission keys
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model User {
  id                String    @id @default(uuid())
  membershipNumber  String    @unique
  email             String    @unique
  passwordHash      String
  fullName          String
  phone             String?
  roleId            String?
  roleRel           Role?     @relation(fields: [roleId], references: [id])
  role              String    @default("STUDENT") // Role slug / identifier
  status            String    @default("ACTIVE")  // ACTIVE, SUSPENDED, EXPIRED
  permissions       String?   @default("[]")      // JSON string of custom override permissions
  maxBorrowLimit    Int       @default(5)
  expiryDate        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  loans             CirculationLoan[]
  reservations      Reservation[]
  fines             Fine[]
  bookings          Booking[]
  acquisitionReqs   AcquisitionRequest[]
  savedSearches     SavedSearch[]
  readingLists      ReadingList[]
  auditLogs         AuditLog[]
  referenceQuestions ReferenceQuestion[]
  reproductionRequests ReproductionRequest[]
}

model BibliographicRecord {
  id                String    @id @default(uuid())
  titleArabic       String?
  titleLatin        String
  subtitle          String?
  authors           String    // JSON array string of authors
  scribe            String?
  shelfmark         String    @unique
  callNumber        String?
  isbn              String?
  issn              String?
  doi               String?
  format            String    @default("MANUSCRIPT") // MANUSCRIPT, ARABI_MALAYALAM_PRINT, RARE_BOOK, PERIODICAL, THESIS, AUDIO
  language          String    @default("Arabic")
  publicationYear   String?
  publisher         String?
  extent            String?   // e.g. "84 folios, 21 x 15 cm"
  material          String?   // e.g. "Laid paper, brown ink"
  binding           String?   // e.g. "Limp leather over boards"
  provenance        String?
  summary           String?
  subjects          String    // JSON array string of subject terms
  accessLevel       String    @default("DIGITISED_FULL") // DIGITISED_FULL, READING_ROOM_ONLY, RESTRICTED
  coverImageUrl     String?
  collectionId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  collection        Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  copies            ItemCopy[]
  reservations      Reservation[]
  digitalFolios     DigitalFolio[]
}

model ItemCopy {
  id                String    @id @default(uuid())
  bibRecordId       String
  barcode           String    @unique
  rfidTag           String?   @unique
  location          String    @default("Main Reading Room - Shelf A1")
  status            String    @default("AVAILABLE") // AVAILABLE, ON_LOAN, RESERVED, IN_CONSERVATION, LOST, WITHDRAWN
  copyNumber        Int       @default(1)
  conditionNote     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bibRecord         BibliographicRecord @relation(fields: [bibRecordId], references: [id], onDelete: Cascade)
  loans             CirculationLoan[]
}

model CirculationLoan {
  id                String    @id @default(uuid())
  copyId            String
  userId            String
  issuedAt          DateTime  @default(now())
  dueDate           DateTime
  returnedAt        DateTime?
  renewalCount      Int       @default(0)
  issuedByStaffId   String?
  status            String    @default("ACTIVE") // ACTIVE, RETURNED, OVERDUE
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  copy              ItemCopy  @relation(fields: [copyId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fines             Fine[]
}

model Reservation {
  id                String    @id @default(uuid())
  bibRecordId       String
  userId            String
  requestedAt       DateTime  @default(now())
  availableUntil    DateTime?
  status            String    @default("PENDING") // PENDING, READY_FOR_PICKUP, FULFILLED, CANCELLED, EXPIRED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  bibRecord         BibliographicRecord @relation(fields: [bibRecordId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Fine {
  id                String    @id @default(uuid())
  loanId            String?
  userId            String
  amount            Float
  reason            String    @default("OVERDUE") // OVERDUE, DAMAGE, LOST
  status            String    @default("UNPAID")  // UNPAID, PAID, WAIVED
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  loan              CirculationLoan? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DigitalFolio {
  id                String    @id @default(uuid())
  bibRecordId       String
  folioNumber       Int
  label             String    // e.g. "Folio 1r"
  imageUrl          String
  thumbnailUrl      String?
  ocrTextArabic     String?
  ocrTextLatin      String?
  fileSize          Int?
  mimeType          String?   @default("image/jpeg")
  createdAt         DateTime  @default(now())

  bibRecord         BibliographicRecord @relation(fields: [bibRecordId], references: [id], onDelete: Cascade)
}

model Booking {
  id                String    @id @default(uuid())
  userId            String
  type              String    // READING_DESK, STUDY_ROOM, LIBRARIAN_CONSULTATION
  resourceName      String    // e.g. "Desk #04", "Manuscript Research Lab", "Reference Consultation"
  date              DateTime
  timeSlot          String    // e.g. "09:00 - 13:00"
  status            String    @default("CONFIRMED") // CONFIRMED, CANCELLED
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AcquisitionRequest {
  id                String    @id @default(uuid())
  userId            String
  title             String
  author            String?
  publisher         String?
  estimatedPrice    Float?
  reason            String?
  status            String    @default("SUBMITTED") // SUBMITTED, APPROVED, ORDERED, REJECTED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedSearch {
  id                String    @id @default(uuid())
  userId            String
  query             String
  filters           String?   // JSON representation of active facets
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadingList {
  id                String    @id @default(uuid())
  userId            String
  name              String
  itemIds           String    // JSON array of bibRecordIds
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReferenceQuestion {
  id                String    @id @default(uuid())
  userId            String?
  name              String
  email             String
  subject           String?
  question          String
  status            String    @default("OPEN") // OPEN, ANSWERED, CLOSED
  answer            String?
  answeredByStaffId String?
  answeredAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id                String    @id @default(uuid())
  userId            String?
  action            String    // ISSUE, RETURN, RENEW, CATALOG_CREATE, MEMBER_UPDATE, SETTING_CHANGE
  entity            String    // LOAN, RECORD, USER, FINE
  entityId          String?
  details           String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  id                String    @id @default(uuid())
  key               String    @unique
  value             String
  description       String?
  updatedAt         DateTime  @updatedAt
}

model NewsletterSubscriber {
  id                String    @id @default(uuid())
  email             String    @unique
  createdAt         DateTime  @default(now())
}

model ContentItem {
  id                String    @id @default(uuid())
  slug              String    @unique
  category          String    // EVENT, NEWS, STORY, OPPORTUNITY
  title             String
  kicker            String?
  summary           String
  content           String?
  date              String?
  time              String?
  venue             String?
  capacity          Int?      @default(100)
  registered        Int?      @default(0)
  deadline          String?
  stipend           String?
  author            String?
  imageUrl          String?
  featured          Boolean   @default(false)
  status            String    @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  tags              String    @default("[]")     // JSON array of strings
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Vendor {
  id                String    @id @default(uuid())
  name              String
  type              String?   // e.g. Publisher, Bindery, Subscription Agent
  contactPerson     String?
  email             String?
  phone             String?
  notes             String?
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Department {
  id                String    @id @default(uuid())
  name              String    @unique
  headOfDepartment  String?
  budget            Float?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assets            Asset[]
}

model MembershipType {
  id                String    @id @default(uuid())
  name              String    @unique
  maxBorrowLimit    Int       @default(5)
  loanDurationDays  Int       @default(14)
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Asset {
  id                String    @id @default(uuid())
  name              String
  category          String?   // e.g. Furniture, Equipment, Conservation Tool
  serialNumber      String?
  location          String?
  status            String    @default("ACTIVE") // ACTIVE, IN_MAINTENANCE, RETIRED, LOST
  purchaseDate      DateTime?
  purchaseCost      Float?
  notes             String?
  departmentId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  maintenanceLogs   AssetMaintenance[]
  audits            AssetAudit[]
}

model AssetMaintenance {
  id                String    @id @default(uuid())
  assetId           String
  description       String
  cost              Float?
  performedBy       String?
  performedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model AssetAudit {
  id                String    @id @default(uuid())
  assetId           String
  condition         String    // GOOD, FAIR, DAMAGED, MISSING
  notes             String?
  auditedBy         String?
  auditedAt         DateTime  @default(now())
  createdAt         DateTime  @default(now())

  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Collection {
  id                String    @id @default(uuid())
  name              String    @unique
  slug              String    @unique
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  records           BibliographicRecord[]
}

model Serial {
  id                String    @id @default(uuid())
  title             String
  shelfmark         String?
  frequency         String?   // e.g. Monthly, Quarterly, Annual
  publisher         String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  issues            SerialIssue[]
}

model SerialIssue {
  id                String    @id @default(uuid())
  serialId          String
  issueLabel        String
  expectedDate      DateTime?
  receivedDate      DateTime?
  status            String    @default("EXPECTED") // EXPECTED, RECEIVED, MISSING, CLAIMED
  createdAt         DateTime  @default(now())

  serial            Serial    @relation(fields: [serialId], references: [id], onDelete: Cascade)
}

model ReproductionRequest {
  id                String    @id @default(uuid())
  userId            String
  itemDescription   String
  format            String?   // e.g. PDF/300 DPI, TIFF/600 DPI
  purpose           String?
  status            String    @default("SUBMITTED") // SUBMITTED, IN_PROGRESS, READY, DELIVERED, REJECTED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
