# ===============================================
# KMLRI Library & Research Institute - Root .env
# ===============================================

# -----------------
# NestJS Backend API
# -----------------
PORT=4000
NODE_ENV=development

# Database: SQLite for zero-config dev, PostgreSQL for production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://kmlri_user:secure_password@localhost:5432/kmlri_db?schema=public"

JWT_SECRET="kmlri-super-secure-jwt-secret-key-2026"
JWT_EXPIRATION="7d"
CORS_ORIGIN="http://localhost:3000,http://admin.localhost:3000,https://kmlri.in,https://admin.kmlri.in"

# -----------------
# Next.js Frontend
# -----------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
